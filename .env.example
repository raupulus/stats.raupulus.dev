# ==========================================
# SERVIDOR Y RED
# ==========================================
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
BIND_IP=127.0.0.1
LOG_LEVEL=INFO
PROFILES_CONFIG_PATH=config/profiles.json
SQLITE_DB_PATH=data/stats.db
PUBLIC_DIR_PATH=public

# ==========================================
# SEGURIDAD Y CONTROL DE ACCESO (3 CANALES)
# ==========================================
# Token obligatorio (Bearer) para API REST privada (/api/v1/*) y WebSockets privados (/ws/stats, /ws/profiles/*)
# Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
API_BEARER_TOKEN=

# Orígenes permitidos para CORS y para el WebSocket público (/ws/public)
CORS_ALLOWED_ORIGINS=https://stats.raupulus.dev,https://raupulus.dev,http://localhost:8000,http://127.0.0.1:8000
WS_PUBLIC_ALLOWED_ORIGINS=https://stats.raupulus.dev,https://raupulus.dev,http://localhost:8000,http://127.0.0.1:8000
WS_PUBLIC_MAX_PER_IP=5
WS_PUBLIC_MAX_CONNECTIONS=200

# ==========================================
# INTERVALOS DE RECOLECCIÓN (Segundos)
# ==========================================
POLL_INTERVAL_YOUTUBE=300         # 5 min (consume solo 1 unidad de cuota por llamada batch)
POLL_INTERVAL_BLUESKY=120         # 2 min (API pública abierta y rápida)
POLL_INTERVAL_MASTODON=180        # 3 min (API pública por instancia)
POLL_INTERVAL_TWITTER=600         # 10 min (evitar rate-limits en Syndication/GraphQL)
POLL_INTERVAL_INSTAGRAM=900       # 15 min (Meta Graph API o perfil web)
POLL_INTERVAL_TIKTOK=900          # 15 min (evitar bloqueos por huella TLS)
POLL_INTERVAL_LINKEDIN=3600       # 60 min (red restrictiva)
POLL_INTERVAL_CRYPTO=60           # 1 min (Binance Public API sin tokens)
POLL_INTERVAL_KEYCOUNTER=60       # 1 min (API v2 keycounter: máx 60 req/min por token)

# Retención de snapshots históricos en SQLite (días)
SNAPSHOT_RETENTION_DAYS=30

# ==========================================
# CREDENCIALES DE PLATAFORMAS
# ==========================================
# Keycounter API v2 (Bearer Token y URL del servidor privado de telemetría)
KEYCOUNTER_API_URL=https://api.example.com/api/v2/keycounter/stats
KEYCOUNTER_API_TOKEN=
# YouTube Data API v3 (API Key permanente de Google Cloud Console)
YOUTUBE_API_KEY=

# Instagram Graph API (System User Token permanente por credentials_ref, ej. MAIN, PROYECTO)
IG_MAIN_USER_ID=
IG_MAIN_ACCESS_TOKEN=

# Twitter / X (Opcional para métricas extendidas de último post si Syndication no basta)
TWITTER_AUTH_TOKEN_COOKIE=
TWITTER_CT0_COOKIE=

# TikTok (Opcional: Display API Client Key/Secret para auto-refresh o msToken cookie)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# LinkedIn (Opcional: Organization Token o li_at cookie para modo personal)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_LI_AT_COOKIE=
